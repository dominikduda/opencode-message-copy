{
  "name": "opencode-message-copy",
  "version": "0.3.1",
  "description": "Fuzzy-search, preview, and copy any user or assistant message from the OpenCode TUI.",
  "type": "module",
  "license": "MIT",
  "author": "dominikduda",
  "repository": {
    "type": "git",
    "url": "https://github.com/dominikduda/opencode-message-copy.git"
  },
  "homepage": "https://github.com/dominikduda/opencode-message-copy#readme",
  "bugs": {
    "url": "https://github.com/dominikduda/opencode-message-copy/issues"
  },
  "keywords": [
    "opencode",
    "opencode-plugin",
    "opencode-tui-plugin",
    "tui",
    "clipboard",
    "fuzzy-search",
    "message-copy"
  ],
  "engines": {
    "opencode": ">=1.18.34 <2"
  },
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "types": "./dist/tui.d.ts",
      "import": "./dist/tui.js"
    },
    "./tui": {
      "types": "./dist/tui.d.ts",
      "import": "./dist/tui.js",
      "config": {
        "binding": "<leader>Y",
        "includeUser": true,
        "includeAssistant": true
      }
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "clean": "node --input-type=module -e \"import { rmSync } from 'node:fs'; rmSync('dist', { recursive: true, force: true })\"",
    "typecheck": "tsc --noEmit",
    "build": "npm run clean && tsc -p tsconfig.build.json",
    "prepack": "npm run typecheck && npm run build",
    "pack:check": "npm pack --dry-run"
  },
  "dependencies": {
    "@opentui/core": "0.4.5",
    "@opentui/solid": "0.4.5",
    "solid-js": "1.9.12"
  },
  "devDependencies": {
    "@opencode-ai/plugin": "latest",
    "@types/node": "^22.0.0",
    "typescript": "^5.8.0"
  }
}
